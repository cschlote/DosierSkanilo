{
	"targetType": "executable",
	"name": "dosierskanilo",
	"targetPath": "build/bin",
	"description": "DosierSkanilo is a blob-centric media and archive file scanner that computes checksums, extracts metadata, and stores JSON results for duplicate detection.",
	"authors": [
		"Carsten Schlote"
	],
	"copyright": "Created 2018, Carsten Schlote",
	"license": "CC-BY-NC-SA 4.0",
	"dependencies": {
		"silly": "~>1",
		"mediainfo-d": "~>26",
		"jsonizer": "~>0",
		"xxhash3": "~>0"
	},
	"systemDependencies": "Install library on debian/ubuntu: apt install -y libmediainfo0v5 libmediainfo-dev",
	"versions": [
		"useJSONStorage"
	],
	"preGenerateCommands": [
		"mkdir -p build/bin",
		"git describe --long --always > build/bin/build-version.txt"],
	"dflags": [
		"-J."
	],
	"sourcePaths": [
		"source"
	],
	"configurations": [
		{
			"name": "cli",
			"targetType": "executable",
			"mainSourceFile": "source/dosierskanilo_cli/main.d"
		},
		{
			"name": "library",
			"targetType": "library"
		}
	]
}
