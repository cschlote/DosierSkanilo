{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "type": "lldb",
            "request": "launch",
            "name": "Launch CLI scan (CodeLLDB): Save",
            "program": "${workspaceFolder}/build/bin/dosierskanilo",
            "args": [
                "scan",
                "./",
                "--json=.filescanner.json",
                "--recursive",
                "--verbose",
                "--file-types",
                "--media-info",
                "--checksums",
                "--scan-archives",
                "--merge-duplicates",
                // "--scan-torrents",
                // "--archive-cache-dir=./.archive-cache",
                // "--archive-cache-size=1024",
                // "--pretty",
                // "--threads=0"
            ],
            "cwd": "/mnt/sshfs/"
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "Launch CLI scan (CodeLLDB): Dry Run",
            "program": "${workspaceFolder}/build/bin/dosierskanilo",
            "args": [
                "scan",
                "./",
                "--json=.filescanner.json",
                "--recursive",
                "--verbose",
                "--file-types",
                "--media-info",
                "--checksums",
                "--scan-archives",
                "--merge-duplicates",
                "--dry-run",
                // "--scan-torrents",
                // "--archive-cache-dir=./.archive-cache",
                // "--archive-cache-size=1024",
                // "--pretty",
                // "--threads=0"
            ],
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "Launch Testbench (CodeLLDB)",
            "program": "${workspaceFolder}/build/bin/dosierskanilo-test-library",
            "args": [
                "--",
                "-v",
                "-t0",
                "-i", "updateArchives"
            ],
            "cwd": "${workspaceFolder}"
        }
    ]
}