pkgname=dosierskanilo
pkgver=26.16.0
pkgrel=1
pkgdesc='Blob-centric media and archive file scanner'
arch=('x86_64')
url='https://github.com/cschlote/DosierSkanilo'
license=('GPL-3.0-only')
depends=('libmediainfo' 'sqlite')
optdepends=('file: file type signatures' 'unzip: ZIP archive scanning and extraction' 'tar: TAR archive scanning and extraction' 'unrar: RAR archive scanning and extraction' 'p7zip: 7z archive scanning and extraction' 'python3: exact duplicate-name ZIP member extraction')
makedepends=('ldc' 'dub' 'git')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  cd "$srcdir/DosierSkanilo-$pkgver"
  DC=ldc2 DFLAGS="-O3 -release -boundscheck=off" dub build --compiler=ldc2 --config=cli --build=plain
}

package() {
  cd "$srcdir/DosierSkanilo-$pkgver"
  install -Dm755 build/bin/dosierskanilo "$pkgdir/usr/bin/dosierskanilo"
  install -Dm644 LICENSE.md "$pkgdir/usr/share/licenses/$pkgname/LICENSE.md"
}
